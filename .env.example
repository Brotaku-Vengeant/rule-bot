# Copy this file to .env and fill in your token.
# .env is gitignored - never commit your real token.

# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste_your_bot_token_here

# Optional: path to the rulebook PDF (only needed to re-run extraction)
RULEBOOK_PDF=rulebook/amtgard-rulebook.pdf
